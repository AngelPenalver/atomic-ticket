NODE_ENV=development
PORT=3000

# Local database (docker-compose). In Cloud Run use DATABASE_URL instead.
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_DB=atomic-ticket-db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://user:pass@/db?host=/cloudsql/PROJECT:REGION:INSTANCE

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

FRONTEND_URL=http://localhost:3000

# Required in the x-api-key header for admin endpoints (min. 16 characters)
ADMIN_API_KEY=change-me-to-a-long-random-string

# Minutes a seat stays locked waiting for payment
RESERVATION_TTL_MINUTES=15
